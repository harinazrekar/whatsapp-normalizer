# Any string you choose. Enter the same value in the Meta App Dashboard
# webhook config -- it's how the verification handshake trusts you.
# The service refuses to start while this is unset or "change-me".
WHATSAPP_VERIFY_TOKEN=change-me

# Meta App Dashboard -> App Settings -> Basic -> App Secret.
# Used to verify the X-Hub-Signature-256 header on every delivery. This is the
# only thing that actually proves a request came from Meta rather than from
# someone who found your webhook URL.
WHATSAPP_APP_SECRET=

# Set to false ONLY for local development before you have an app secret.
# Any deployment reachable from the internet must leave this true.
REQUIRE_SIGNATURE=true

# Where normalized events get POSTed after dedup. Your backend, an n8n
# webhook node, a Slack incoming webhook, etc. Leave blank to just queue
# and inspect events via /stats without forwarding anywhere yet.
DOWNSTREAM_WEBHOOK_URL=

REDIS_URL=redis://redis:6379/0

DEDUP_TTL_SECONDS=86400
MAX_RETRIES=5
RETRY_BACKOFF_BASE=2

# slowapi limit string applied to POST /webhook.
WEBHOOK_RATE_LIMIT=120/minute

# --- Production only (docker-compose.prod.yml + Caddy) ----------------------
# Unused in local dev, where ngrok supplies the hostname and the certificate.
# Caddy fails to start if either is missing when you use the prod compose file.

# The hostname whose DNS A/AAAA record points at this server. Caddy requests a
# certificate for exactly this name, so a mismatch means no TLS and no webhook.
DOMAIN=wa.example.com

# Where Let's Encrypt sends certificate-expiry warnings. A real mailbox you read.
ACME_EMAIL=ops@example.com

# --- Redis client tuning ----------------------------------------------------
# Read timeout for ordinary commands. Deliberately independent of BLOCK_MS: the
# API never issues a blocking command and must not inherit a worker knob.
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_CONNECT_TIMEOUT_SECONDS=5

# redis-py 8 applies a finite socket timeout to every command, so a single slow
# reply raises instead of blocking. Retries ride out brief stalls (AOF rewrite
# forks, memory pressure) that used to pass unnoticed.
REDIS_RETRIES=3
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# How long the worker loop waits after a Redis error before retrying, so a
# sustained outage does not become a hot spin.
REDIS_ERROR_BACKOFF_SECONDS=5

# Port the worker serves its own Prometheus registry on. Delivery, retry, DLQ
# and reclaim counters live in that process and are NOT on the API metrics.
# Scrape both targets.
WORKER_METRICS_PORT=9100
